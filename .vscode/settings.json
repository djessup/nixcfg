  // "nix.serverPath": "nixd",

  // "nix.serverSettings": {
  //     "nixd": {
  //         "formatting": {
  //             "command": [
  //                 "nixpkgs-fmt"
  //             ]
  //         },
  //         "nixpkgs": {
  //             "expr": "import (builtins.getFlake \"${workspaceFolder}/flake.nix\").inputs.nixpkgs {}"
  //         },
  //         "options": {
  //             "home_manager": {
  //                 /*the below is for those who directly integrate their home manager into nixos, what others use is for stand alone home manager*/
  //                 "expr": "(builtins.getFlake \"${workspaceFolder}/flake.nix\").darwinConfigurations.jessup-m3.options.home-manager.users.type.getSubOptions []"
  //             },
  //             "nixos": {
  //                 "expr": "(builtins.getFlake \"${workspaceFolder}/flake.nix\").darwinConfigurations.jessup-m3.options"
  //             },
  //             // Tip: use ${workspaceFolder} variable to define path
  //             "nix-darwin": {
  //                 "expr": "(builtins.getFlake \"${workspaceFolder}/flake.nix\").darwinConfigurations.jessup-m3.options"
  //             }
  //         }
  //     }
  // },
  "chat.tools.terminal.autoApprove": {
    "nix": true
  }
}
